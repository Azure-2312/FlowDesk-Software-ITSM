# Copia este archivo como ".env.local" y completa con los datos reales de tu proyecto de Supabase
# (Project Settings -> Database -> Connection string -> "URI")
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"

# Cualquier texto largo y secreto, usado para firmar las sesiones (JWT) del login
JWT_SECRET="cambia-esto-por-un-texto-largo-y-aleatorio"

# Configuración de Gmail para envío de códigos de recuperación
GMAIL_USER="tu_correo@gmail.com"
GMAIL_APP_PASSWORD="tu_contraseña_de_aplicacion"
