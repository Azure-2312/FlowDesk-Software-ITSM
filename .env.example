# Copia este archivo como ".env.local" y completa con los datos reales de tu proyecto de Supabase
# (Project Settings -> Database -> Connection string -> "URI")
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"

# Cualquier texto largo y secreto, usado para firmar las sesiones (JWT) del login
JWT_SECRET="cambia-esto-por-un-texto-largo-y-aleatorio"

# API de Solicitantes para otros equipos (/api/v1/auth/token y /api/v1/solicitantes)
# "Pepper" con el que se firman (HMAC-SHA256) los secretos y tokens. Mínimo 32 caracteres.
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si falta o es corto, la API responde 503 (falla cerrada). Cambiarlo invalida todas las credenciales.
API_KEY_SALT=""

# API de clientes de la empresa externa (Equipo 10). La clave la entrega ese equipo por privado.
EQUIPO10_API_KEY=""
# EQUIPO10_API_URL="https://carrito-equipo10.onrender.com"

# Facturación electrónica SUNAT (fact_api: https://github.com/angelitosystems/fact_api)
# Usuario de fact_api con el que FlowDesk inicia sesión (POST /api/auth/login),
# o un token Sanctum ya emitido. Si el valor tiene "#", va entre comillas.
FACT_API_EMAIL=""
FACT_API_PASSWORD=""
# FACT_API_TOKEN=""
