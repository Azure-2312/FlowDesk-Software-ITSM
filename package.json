{
  "name": "sistema-tickets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/verificar_estilos.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:start": "pg_ctl start -D \"%USERPROFILE%\\AppData\\Local\\Programs\\pgsql\\data\" -l \"%USERPROFILE%\\AppData\\Local\\Programs\\pgsql\\logfile.log\"",
    "db:status": "pg_ctl status -D \"%USERPROFILE%\\AppData\\Local\\Programs\\pgsql\\data\"",
    "db:stop": "pg_ctl stop -D \"%USERPROFILE%\\AppData\\Local\\Programs\\pgsql\\data\"",
    "test:estilos": "node scripts/verificar_estilos.js --detalle"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.35",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  }
}
